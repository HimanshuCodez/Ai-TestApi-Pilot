# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://testpilot:testpilot@localhost:5432/testpilot?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# GitHub (Phase 2 — public repo analysis; unauthenticated calls are rate-limited without this)
GITHUB_TOKEN=
